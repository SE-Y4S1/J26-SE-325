# Component 4 (Agentic Assistance). Copy to .env in this folder; the repository-root .env is
# read too, and values already in the environment always win. Every line is optional: the
# defaults shown are what the service uses when a value is unset.

# --- Local LLM (Ollama) -------------------------------------------------------------------
# No API key exists: the agent runs on a local Ollama model. In docker-compose this is
# http://ollama:11434; on the host, Ollama's default port.
OLLAMA_HOST=http://localhost:11434
# OLLAMA_BASE_URL takes precedence over OLLAMA_HOST when both are set.
# OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
LLM_MAX_TOKENS=250
LLM_KEEP_ALIVE=60m

# --- Other components (read-only lookups; each falls back to labelled mock data) -----------
PLATFORM_SERVICE_URL=http://localhost:8100
COMPONENT1_SERVICE_URL=http://localhost:8000
FRAUD_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002
# Seconds per lookup before falling back.
PLATFORM_SERVICE_TIMEOUT=1.5
PORTFOLIO_SERVICE_TIMEOUT=1.5
FRAUD_SERVICE_TIMEOUT=1.5
AUDIT_SERVICE_TIMEOUT=1.5

# --- Authentication -----------------------------------------------------------------------
# The same secret the platform service signs tokens with (repository-root .env). Used to
# verify callers on the governance endpoints, and by the portfolio tool to mint a token for
# PLATFORM_USER_ID when no caller token is forwarded.
JWT_SECRET=
# true = governance endpoints reject requests without a valid bearer token.
AUTH_REQUIRED=false
# Portfolio tool defaults when a question names no user or portfolio.
PLATFORM_USER_ID=1
PORTFOLIO_ID=1
# A fixed bearer token for the portfolio tool instead of minting one. Leave unset normally.
# PORTFOLIO_AUTH_TOKEN=

# --- Storage ------------------------------------------------------------------------------
# Confirmed/rejected governance decisions (JSON Lines). Default: data/governance_decisions.jsonl.
# GOVERNANCE_DATA_PATH=
