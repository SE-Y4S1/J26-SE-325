# Copy to .env. Everything here is OPTIONAL -- the default data path (yfinance + GDELT)
# needs no credentials at all.

# NewsAPI: only used for the recent/live sentiment window. Historical backfill comes from
# GDELT, which needs no key. Without this, news falls back to GDELT for all date ranges.
NEWSAPI_KEY=

# Reddit / praw. Social sentiment is DISABLED by default in configs/universe.yaml.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=j26-se-325-component1/0.1

# Kafka. Set KAFKA_ENABLED=false to run fully standalone; the producer degrades to a no-op
# and the service never blocks on a broker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# MLflow local file store.
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db

# Ollama, for the Phase 5c reference agent only (a stand-in until the Colab model is ready).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4-e4b

# Sentiment scoring backend: auto | finbert | ollama.
# auto uses FinBERT if its ~420MB of weights are already cached, else the local Ollama
# model above. Nothing here ever starts a download on its own.
SENTIMENT_BACKEND=auto

# --- Market data and per-stock sentiment (news/, data/exchanges/) ----------------------
# Platform base currency. Holdings keep their native currency (CSE: LKR, Yahoo: USD,
# Binance: the pair's quote asset); totals and withdrawal targets are expressed in this.
BASE_CURRENCY=LKR

# Optional channels. Each reports "not configured" on /analysis/channels until set.
# Jina: web search, plus a site:linkedin.com pass for public LinkedIn posts.
JINA_API_KEY=

# Agent-Reach logged-in channels (twitter-cli, OpenCLI). Install Agent-Reach on the HOST,
# use a dedicated account (cookie automation can get accounts banned), then run
#   python -m news.pipeline --all
# on the host. OpenCLI channels (Instagram, Facebook, Reddit, LinkedIn) reuse the host's
# logged-in Chrome and cannot run inside the service container.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# FX conversion spread charged by the withdrawal GA on proceeds converted into the base
# currency (fractions). Assumptions, not quotes.
FX_SPREAD_FIAT=0.0075
FX_SPREAD_STABLECOIN=0.01

# Colab Part D only: SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT=
