# Component 3 audit bridge. Copy to .env in this folder (read on start via dotenv).

PORT=8002

# --- Off-chain record store -----------------------------------------------------------------
# Postgres when set: Prisma Postgres DIRECT connection string (postgres://...@db.prisma.io).
# Required on hosts whose disk is wiped on restart (Render's free plan); it also persists the
# mock ledger, so commitments survive restarts.
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# SQLite file, used when DATABASE_URL is unset. Default: data/audits.sqlite.
# DB_PATH=

# --- Ledger -----------------------------------------------------------------------------------
# mock = simulated ledger, no chain needed. Unset = a real EVM node via the settings below.
BLOCKCHAIN_MODE=mock
# Real chain (local Hardhat node, or a testnet such as Sepolia via a free RPC endpoint).
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed AuditRegistry address and ABI. Default: config/contractConfig.json.
# CONTRACT_CONFIG_PATH=
# Signs anchoring transactions. A SECRET: set it in the environment or a host's secret
# store, never in a committed file. Without it the node's first account is used, which
# only exists on a local Hardhat node; a public testnet needs this key.
# SIGNER_PRIVATE_KEY=

# --- Assurance engine -------------------------------------------------------------------------
# Policy that routes requests carrying assurance signals (src/policies). Default: P002.
# ACTIVE_ASSURANCE_POLICY=P002
# true = route requests WITHOUT signals through the active policy too (on a degraded basis,
# never AUTO). Default false: such requests keep the legacy P001 behaviour unchanged.
# ASSURANCE_REQUIRE_SIGNALS=false

# --- Access control ---------------------------------------------------------------------------
# Same HS256 tokens the platform service issues (issuer j26-se-325-platform). Off by default,
# as in Component 1; turn on in production.
# AUTH_REQUIRED=false
# The platform's shared secret. A SECRET: never commit it.
# JWT_SECRET=
# Platform user ids allowed to review held decisions and read records/evidence.
# AUDIT_REVIEWER_IDS=7,12
# Key for the keyed subject references used in separation-of-duties checks. Default: derived
# from JWT_SECRET (HKDF, label "c3-subject-ref"); set only if it must differ, on both services.
# AUDIT_PSEUDONYM_KEY=
# Browser origins allowed to call this service. Unset = any origin (legacy behaviour; a warning
# is printed). Set it to the frontend origin in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Demo controls ----------------------------------------------------------------------------
# Tamper simulation and record reset are disabled when NODE_ENV=production unless this is true.
# NODE_ENV=development
# ALLOW_DEMO_TAMPER=false
