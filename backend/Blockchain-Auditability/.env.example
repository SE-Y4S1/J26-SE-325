# Component 3 audit bridge. Copy to .env in this folder (read on start via dotenv).

PORT=8002

# --- Off-chain record store -----------------------------------------------------------------
# Postgres when set: Prisma Postgres DIRECT connection string (postgres://...@db.prisma.io).
# Required on hosts whose disk is wiped on restart (Render's free plan); it also persists the
# mock ledger, so commitments survive restarts.
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# SQLite file, used when DATABASE_URL is unset. Default: data/audits.sqlite.
# DB_PATH=

# --- Ledger -----------------------------------------------------------------------------------
# mock = simulated ledger, no chain needed. Unset = a real EVM node via the settings below.
BLOCKCHAIN_MODE=mock
# Real chain (local Hardhat node, or a testnet such as Sepolia via a free RPC endpoint).
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed AuditRegistry address and ABI. Default: config/contractConfig.json.
# CONTRACT_CONFIG_PATH=
# Signs anchoring transactions. A SECRET: set it in the environment or a host's secret
# store, never in a committed file. Without it the node's first account is used, which
# only exists on a local Hardhat node; a public testnet needs this key.
# SIGNER_PRIVATE_KEY=

# --- Demo controls ----------------------------------------------------------------------------
# The tamper-evidence demonstration is disabled when NODE_ENV=production unless this is true.
# NODE_ENV=development
# ALLOW_DEMO_TAMPER=false
