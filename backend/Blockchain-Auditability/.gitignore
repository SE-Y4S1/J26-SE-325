# Dependencies
**/node_modules/

# Environment / Secrets
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
# Templates hold no values and document the settings, so they are committed.
!**/.env.example
*.pem
*.key
*.crt

# Build & Bundle Outputs
**/dist/
**/build/
**/out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Hardhat & Smart Contract Build Artifacts
blockchain/artifacts/
blockchain/cache/
blockchain/typechain/
blockchain/typechain-types/
src/config/contractConfig.json

# Local Runtime Audit Data
data/*.json
data/*.sqlite*
data/*.bak-*
!data/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm

# IDEs, Editors & OS Files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Testing & Coverage
coverage/
.nyc_output/

# Temporary & Cache Files
*.tmp
*.temp
.eslintcache
# Research pipeline: environment and row-level caches stay local; aggregate results are committed.
research/.venv/
research/results/**/cache/
research/**/__pycache__/
research/.pytest_cache/
