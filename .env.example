# Nexa: every setting for every service, in one file.
#
#   cp .env.example .env          then fill in JWT_SECRET (required) and anything optional
#   docker compose up -d          the whole system   -> http://localhost:3000
#   docker compose up -d platform component2         any subset, by service name
#
# Service names: platform, component1 (portfolio), component2 (fraud), component3 (audit),
# component4 (assistant), frontend, plus kafka, mlflow, ollama.
#
# docker-compose.yml passes each service ONLY the variables it uses, and pins the values that
# must be container-network addresses (service URLs, Kafka, Ollama). A value left empty or
# commented out falls back to the default shown. Never commit the filled-in .env.

# =========================================================================================
# Shared
# =========================================================================================

# Signs (platform) and verifies (portfolio, assistant) every login token. REQUIRED.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The platform refuses to start if this is unset, shorter than 32 characters, or the
# placeholder below.
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed to call the backends, comma-separated. Add your Vercel domain when
# the frontend is hosted.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# true = the portfolio and assistant services reject requests without a valid token.
AUTH_REQUIRED=true

# The assistant's local model; compose's ollama service pulls exactly this one.
# Component 1's sentiment fallback keeps its own research model (gemma4-e4b, set in
# backend/Portfolio-Optimization), so changing this never alters its results.
OLLAMA_MODEL=llama3.2:3b

# =========================================================================================
# Database (platform + Component 3 audit)
# =========================================================================================

# Unset = local SQLite inside Docker volumes (separate from any hosted data).
# Set = Prisma Postgres DIRECT connection string, shared by platform and audit. Not the
# prisma+postgres:// Accelerate URL: the platform refuses that one at startup.
# NOTE: pointing local compose at the same database as Render mixes local test data into
# production. Use a separate Prisma database for local work if that matters.
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# =========================================================================================
# Platform service
# =========================================================================================

# Seconds the platform waits for the fraud and audit services before HOLDING an execution.
PIPELINE_TIMEOUT_SECONDS=10
# Used only when running the platform outside Docker (compose pins in-network addresses).
FRAUD_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002

# =========================================================================================
# Component 1: portfolio optimization
# =========================================================================================

# Base currency for totals and withdrawal targets. Holdings keep their native currency.
BASE_CURRENCY=LKR
# FX conversion spread charged on proceeds (fractions; assumptions, not quotes).
FX_SPREAD_FIAT=0.0075
FX_SPREAD_STABLECOIN=0.01
# auto | finbert | ollama. auto uses FinBERT only if its weights are already cached.
SENTIMENT_BACKEND=auto

# Optional data channels; each reports "not configured" until set.
NEWSAPI_KEY=
JINA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=j26-se-325-component1/0.1
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# SEC EDGAR requires a descriptive User-Agent with a contact address (Colab Part D).
SEC_USER_AGENT=

# =========================================================================================
# Component 2: fraud detection
# =========================================================================================

# true = also consume/publish the Kafka topics (finance.transactions.raw / .fraud.decisions).
FRAUD_ENABLE_KAFKA=false
# Kaggle credentials for scripts/download_datasets.py belong in ~/.kaggle/kaggle.json,
# not here (see backend/Fraud-Detection/docs/DATASETS.md).

# =========================================================================================
# Component 3: audit bridge
# =========================================================================================

# mock = simulated ledger (no chain needed). Empty = a real EVM node, set below.
BLOCKCHAIN_MODE=mock
# Real chain: RPC endpoint (local Hardhat or a testnet such as Sepolia) and signing key.
# SIGNER_PRIVATE_KEY is a SECRET; without it the node's first account is used, which only
# exists on a local Hardhat node.
BLOCKCHAIN_RPC_URL=
SIGNER_PRIVATE_KEY=
# The Audit screen's tamper-evidence demonstration.
ALLOW_DEMO_TAMPER=true

# =========================================================================================
# Component 4: assistant
# =========================================================================================

LLM_MAX_TOKENS=250
LLM_KEEP_ALIVE=60m
# Portfolio tool defaults when a question names no user or portfolio.
PLATFORM_USER_ID=1
PORTFOLIO_ID=1

# =========================================================================================
# Frontend (baked into the image at build time; rebuild after changing)
# =========================================================================================

# The URLs the BROWSER uses, so localhost for a local stack.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8100
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:8000
NEXT_PUBLIC_FRAUD_URL=http://localhost:8001
NEXT_PUBLIC_AUDIT_URL=http://localhost:8002
NEXT_PUBLIC_ASSISTANT_URL=http://localhost:8003
