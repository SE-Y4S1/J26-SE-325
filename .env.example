# Copy to .env at the repository root. Read by docker-compose.yml.
#
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every backend service shares this one value: the platform service ISSUES tokens with it and
# each component VERIFIES them with it. That is what lets a component authenticate a request
# without calling the platform service on every hit — so a slow or restarted platform cannot
# take the others down with it.
#
# The platform service refuses to start if this is unset, shorter than 32 characters, or
# still the placeholder below. A default secret that silently works everywhere is the classic
# way this ends up forgeable by anyone who has read the repository.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the backends. The frontend calls each
# service directly, so every service must permit the frontend's origin or the browser
# discards the response before any handler runs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Component 4's agent runs on a LOCAL Ollama model (agent.py uses ChatOllama), so there is
# no API key to set. It needs Ollama running on the host with the model its code asks for;
# without that the service still starts and /health still answers, and only
# /assistant/chat fails -- which the Assistant screen reports rather than implying the whole
# component is missing.

# --- Hosted deployment (Render free plan + Prisma Postgres) -----------------------------
# docker-compose.yml sets these itself for local runs; on Render they are entered per
# service (render.yaml, DEPLOY.md). The platform service and Component 2 read environment
# variables only, never a .env file, so this is where their settings are documented.
#
# Platform and Component 3: Prisma Postgres DIRECT connection string, not the
# prisma+postgres:// Accelerate URL (the platform refuses that one at startup). Unset means
# a local SQLite file, which a free-tier host wipes on every spin-down.
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
#
# Platform -> Components 2 and 3 for executions. If either is unreachable, executions are
# HELD (never run unscreened); raise the timeout where services sleep and wake slowly.
# FRAUD_SERVICE_URL=http://localhost:8001
# AUDIT_SERVICE_URL=http://localhost:8002
# PIPELINE_TIMEOUT_SECONDS=10
#
# Component 2 (fraud): port, settings profile and the optional Kafka adapter.
# FRAUD_API_PORT=8082
# FRAUD_CONFIG=config/default.yaml
# FRAUD_ENABLE_KAFKA=false
# FRAUD_KAFKA_BOOTSTRAP=localhost:9094
# Kaggle credentials for scripts/download_datasets.py go in ~/.kaggle/kaggle.json or the
# shell, never in a committed file (see backend/Fraud-Detection/docs/DATASETS.md).
