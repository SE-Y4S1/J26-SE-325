# Copy to .env.local for local development.
#
# These are NEXT_PUBLIC_ because the browser calls each backend directly — there is no
# Next.js proxy in front of them, so the URLs must be present in the client bundle.
# NEXT_PUBLIC_ values are inlined at BUILD time, not read at runtime: changing one means
# rebuilding, and none of them may ever hold a secret.

NEXT_PUBLIC_PLATFORM_URL=http://localhost:8100
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:8000

# The other three components. Each screen renders an explanatory "not running" state rather
# than an error when its service is down, so these are safe to leave set.
NEXT_PUBLIC_FRAUD_URL=http://localhost:8001
NEXT_PUBLIC_AUDIT_URL=http://localhost:8002
NEXT_PUBLIC_ASSISTANT_URL=http://localhost:8003

# Demo mode: set to 1 to stand in a fake signed-in user so screens can be shown without the
# platform service running. LEAVE THIS UNSET for anything reachable by anyone else -- with it
# on there is no access control, and every page is served to every visitor.
# NEXT_PUBLIC_DEMO_AUTH=1
